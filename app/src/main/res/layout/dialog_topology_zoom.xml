<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        style="@style/Widget.NA.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:title="Topología de Red"
        app:navigationIcon="@drawable/ic_close" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#F5F7FB"
        android:gravity="center"
        android:padding="8dp"
        android:text="Pellizcá para acercar/alejar · arrastrá para mover · doble tap para ver todo"
        android:textColor="#6B7280"
        android:textSize="12sp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#FAFAFA"
        android:clipChildren="true">

        <com.upc.asistenteredidbi.presentation.common.TopologyGraphView
            android:id="@+id/topologyGraphViewZoom"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center" />
    </FrameLayout>

</LinearLayout>
